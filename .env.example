# ----------------------------------------------------------------------------
# Beispiel-Konfiguration. Kopiere diese Datei nach ".env" und passe sie an.
# Ohne .env startet die Anwendung mit sinnvollen Standardwerten (Dev-Modus).
# ----------------------------------------------------------------------------

# Anzeige / Branding
APP_NAME=ABE Druckvorstufe
FIRMA=ABE GmbH
FARBE_AKZENT=#E8930A
FARBE_DUNKEL=#2D2D2D

# Basis-URL, die in den Freigabe-Links der Mail steht.
# WICHTIG: Muss für den Kunden von außen erreichbar sein (VPS oder Portfreigabe).
# Für lokale Tests: http://localhost:8000
BASE_URL=http://localhost:8000

# Gültigkeitsdauer des Freigabe-Links in Tagen
FREIGABE_GUELTIGKEIT_TAGE=7

# ----------------------------------------------------------------------------
# E-Mail-Versand
# SMTP_ENABLED=false  -> Mails werden NICHT verschickt, sondern als .eml in
#                        den Ordner ./outbox geschrieben (ideal zum Testen).
# SMTP_ENABLED=true   -> echter Versand über die untenstehenden Zugangsdaten.
# ----------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vorstufe@abe-brands.de
SMTP_FROM_NAME=ABE Druckvorstufe

# Optionale interne Benachrichtigung, sobald der Kunde entscheidet
BENACHRICHTIGUNG_AN=
